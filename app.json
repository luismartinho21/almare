{
  "expo": {
    "name": "Almare",
    "slug": "almare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almare.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D11"
      },
      "package": "com.almare.app"
    },
    "web": {
      "name": "Almare — Barbearia & Estética | Marcações Online",
      "shortName": "Almare",
      "description": "Agende o seu horário na Almare Barber & Almare Estética de forma rápida e sem instalar nada. Experiências de excelência para Ele e para Ela.",
      "lang": "pt",
      "themeColor": "#0D0D11",
      "backgroundColor": "#0D0D11",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/almare"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D11"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "597f6208-80e1-4e76-bfb2-8cf026640417"
      }
    },
    "owner": "martinho21"
  }
}
